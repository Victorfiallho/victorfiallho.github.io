import pandas as pd
from sklearn.feature_extraction.text import TfidfVectorizer
from sklearn.linear_model import LogisticRegression

# 1. Dados de Treino (Entendendo a entrada)
data = {
    'texto': [
        'Eu amo este modelo de IA', 'Isso é maravilhoso', 'Que algoritmo incrível',
        'Eu odeio erros de sintaxe', 'Este resultado está péssimo', 'Muito ruim e lento'
    ],
    'sentimento': [1, 1, 1, 0, 0, 0]  # 1 = Positivo, 0 = Negativo
}

df = pd.DataFrame(data)

vectorizer = TfidfVectorizer()
X = vectorizer.fit_transform(df['texto'])
modelo = LogisticRegression()
modelo.fit(X, df['sentimento'])
frase = ["Eu adoro estudar engenharia"]
frase_vetorizada = vectorizer.transform(frase)
predicao = modelo.predict(frase_vetorizada)

status = "Positivo" if predicao[0] == 1 else "Negativo"
print(f"A frase '{frase[0]}' tem sentimento: {status}")